# Optional. Without these the app still scans, but the result is not shared
# between visitors, no one sees a scan in progress, and the cooldown cannot be
# enforced server-side.
#
# On Vercel these arrive from the Upstash for Redis integration as KV_REST_API_*,
# so `vercel env pull` fills them in for you. Set the UPSTASH_* pair instead when
# pointing at a database you made yourself.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Salt for hashing visitor IPs before they are used as cooldown keys.
SCAN_IP_SALT=
